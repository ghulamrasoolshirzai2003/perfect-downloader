{
  "name": "@pd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify-based REST API for Perfect Downloader with OpenAPI, streaming, rate limiting, and temporary file management.",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "build": "tsup src/start.ts --format esm --out-dir dist",
    "start": "tsx src/start.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@pd/downloader-core": "*",
    "@pd/media-core": "*",
    "@pd/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "tsx": "^4.19.2"
  }
}
