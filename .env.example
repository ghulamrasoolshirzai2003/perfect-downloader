# Perfect Downloader Configuration Template
# Copy to .env for local overrides. NEVER commit secrets or production credentials.

# API Server
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Next.js Frontend
NEXT_PUBLIC_BASE_URL=https://perfectdownloader.com
API_URL=http://localhost:4000

# Platform Policies
# Comma-separated list of restricted platforms enabled after legal review.
# Default: empty (only open-licensed platforms like archive.org and wikimedia are enabled).
# Example: ENABLED_RESTRICTED_PLATFORMS=youtube,tiktok,instagram,vimeo
ENABLED_RESTRICTED_PLATFORMS=

# Emergency platform killswitch (comma-separated list of platform IDs to disable)
DISABLED_PLATFORMS=

# Storage & Quotas
MAX_UPLOAD_SIZE_MB=200
TEMP_MEDIA_DIR=.tmp/media
JOB_TTL_MS=900000
